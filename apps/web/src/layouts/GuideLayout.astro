---
import publicCatalog from "../data/catalog.public.json";

const {
  title,
  description,
  eyebrow = "GUIA PRÁTICO DE PRECIFICAÇÃO",
  readTime = "4 min de leitura",
  relatedSlug = null,
} = Astro.props;

const liveProduct = relatedSlug
  ? publicCatalog.find((item) => item.slug === relatedSlug && item.status === "live")
  : null;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : null;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Prisma Dados</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />

    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${title} | Prisma Dados`} />
    <meta property="og:description" content={description} />
  </head>

  <body>
    <div class="container">
      <header>
        <a class="brand" href="/">PRISMA <span>DADOS</span></a>
        <nav aria-label="Navegação principal">
          <a href="/guias">GUIAS</a>
        </nav>
      </header>

      <main>
        <article class="article">
          <p class="eyebrow">{eyebrow} · {readTime.toUpperCase()}</p>
          <h1>{title}</h1>
          <p class="lead">{description}</p>

          <div class="prose">
            <slot />
          </div>

          {relatedSlug && (
            <aside class="tool-callout" aria-label="Ferramenta relacionada">
              <p class="eyebrow">FERRAMENTA PRÁTICA</p>
              {liveProduct ? (
                <>
                  <h2>Calcule automaticamente com o {liveProduct.name}</h2>
                  <p>
                    Em vez de refazer essas contas manualmente a cada produto,
                    utilize a planilha estruturada com simulador de descontos e cenários prontos.
                  </p>
                  <a class="cta-link" href={`/p/${liveProduct.slug}`}>
                    Conhecer o {liveProduct.name}
                  </a>
                </>
              ) : (
                <>
                  <h2>Planilha Precifica Fácil — em fase final de liberação</h2>
                  <p>
                    Estamos finalizando a publicação da planilha oficial da Prisma Dados
                    para MEIs e pequenos comerciantes aplicarem esse método sem erro de fórmula.
                  </p>
                </>
              )}
            </aside>
          )}
        </article>
      </main>

      <footer>
        <span>© Prisma Dados</span>
        <a href="/guias">Ver todos os guias educativos</a>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #090e1c;
    color: #f2f5ff;
    font-family: Inter, system-ui, sans-serif;
  }

  .container {
    width: min(860px, calc(100% - 40px));
    margin: auto;
  }

  header, footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  header {
    padding: 28px 0;
    border-bottom: 1px solid #283247;
  }

  .brand {
    color: white;
    font-weight: 900;
    letter-spacing: 2px;
    text-decoration: none;
  }

  .brand span {
    color: #91aaff;
  }

  nav a {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.8px;
    color: #9ab0ff;
    text-decoration: none;
  }

  nav a:hover {
    color: #ffffff;
  }

  .article {
    padding: 56px 0 72px;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #9ab0ff;
    margin: 0 0 14px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 52px);
    letter-spacing: -1.4px;
    line-height: 1.12;
    margin: 0 0 20px;
  }

  .lead {
    font-size: clamp(18px, 2.3vw, 22px);
    color: #c6d3ee;
    line-height: 1.55;
    margin: 0 0 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid #283247;
  }

  .prose :global(h2) {
    font-size: clamp(22px, 3vw, 28px);
    letter-spacing: -0.6px;
    margin: 40px 0 16px;
    color: #f2f5ff;
  }

  .prose :global(p) {
    color: #c2cde3;
    font-size: 17px;
    line-height: 1.8;
    margin: 0 0 20px;
  }

  .prose :global(ul), .prose :global(ol) {
    color: #c2cde3;
    font-size: 17px;
    line-height: 1.8;
    margin: 0 0 24px;
    padding-left: 22px;
  }

  .prose :global(li) {
    margin-bottom: 10px;
  }

  .prose :global(.formula-box) {
    background: #101a30;
    border: 1px solid #293753;
    border-left: 4px solid #91aaff;
    border-radius: 12px;
    padding: 20px 22px;
    margin: 28px 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 15px;
    color: #e6eeff;
    overflow-x: auto;
  }

  .prose :global(.table-wrap) {
    width: 100%;
    overflow-x: auto;
    margin: 28px 0;
    border: 1px solid #293753;
    border-radius: 12px;
    background: #101a30;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    min-width: 520px;
    font-size: 15px;
  }

  .prose :global(th), .prose :global(td) {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid #22304b;
  }

  .prose :global(th) {
    color: #9ab0ff;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .prose :global(tr:last-child td) {
    border-bottom: none;
  }

  .tool-callout {
    margin-top: 52px;
    padding: 28px;
    border-radius: 16px;
    border: 1px solid #35476b;
    background: #101a30;
  }

  .tool-callout h2 {
    margin: 0 0 12px;
    font-size: 24px;
  }

  .tool-callout p {
    margin: 0 0 20px;
    color: #b3bfd7;
    line-height: 1.65;
  }

  .tool-callout p:last-child {
    margin-bottom: 0;
  }

  .cta-link {
    display: inline-block;
    padding: 14px 22px;
    border-radius: 10px;
    background: #98b0ff;
    color: #071126;
    font-weight: 750;
    text-decoration: none;
  }

  .cta-link:hover {
    background: #c4d0ff;
  }

  footer {
    padding: 28px 0 48px;
    border-top: 1px solid #283247;
    color: #9aa9c5;
    font-size: 13px;
  }

  footer a {
    color: #9ab0ff;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .article { padding: 40px 0 56px; }
    .tool-callout { padding: 22px; }
    footer { flex-direction: column; align-items: flex-start; }
  }
</style>
