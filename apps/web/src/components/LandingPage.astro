---
const { product, preview = false } = Astro.props;

const content = product.page;
const media = product.media;
const demos = media?.demos ?? [];
const offer = product.offers?.[0];

const headline = content?.headline ?? product.name;
const subheadline = content?.subheadline ??
  "O conteúdo comercial deste produto ainda não foi cadastrado.";

const title = preview
  ? `Prévia — ${product.name}`
  : content?.seo_title ?? product.name;

const description = preview
  ? "Prévia interna de um produto digital."
  : content?.seo_description ?? "";

const price = offer
  ? new Intl.NumberFormat("pt-BR", {
      style: "currency",
      currency: offer.currency,
    }).format(offer.price_cents / 100)
  : null;

const canBuy =
  !preview &&
  product.status === "live" &&
  Boolean(content) &&
  Boolean(offer?.checkout_url);

const canonical = !preview && Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : null;
const trackingUrl = import.meta.env.PUBLIC_API_URL
  ? `${import.meta.env.PUBLIC_API_URL.replace(/\/$/, "")}/v1/events`
  : null;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={preview ? "noindex,nofollow,noarchive" : "index,follow"}
    />

    {canonical && <link rel="canonical" href={canonical} />}

    {!preview && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
      </>
    )}
  </head>

  <body
    data-tracking-url={trackingUrl ?? undefined}
    data-product-slug={product.slug}
    data-preview={preview ? "true" : "false"}
  >
    <div class="container">
      <header>
        <a class="brand" href="/">PRISMA <span>DADOS</span></a>
        <span class="environment">
          {preview ? "PRÉVIA LOCAL" : "PRODUTOS DIGITAIS"}
        </span>
      </header>

      <main>
        <section class="hero">
          <p class="eyebrow">
            {preview ? "VERSÃO DE PRÉ-LANÇAMENTO" : "SOLUÇÃO DIGITAL"}
          </p>

          <h1>{headline}<span class="accent">.</span></h1>
          <p class="subtitle">{subheadline}</p>

          <div class="actions">
            {canBuy ? (
              <a
                class="buy-button"
                href={offer.checkout_url}
                rel="noopener noreferrer"
                data-tracking-event="checkout_click"
                data-product-slug={product.slug}
              >
                {content.cta_label}
                <span>{price}</span>
              </a>
            ) : (
              <span class="unavailable">
                {preview
                  ? "Compra indisponível nesta prévia"
                  : "Oferta indisponível"}
              </span>
            )}
          </div>

          {content && (
            <p class="description">{content.description}</p>
          )}
        </section>

        {demos.length > 0 && (
          <section class="section" aria-labelledby="demos-heading">
            <p class="eyebrow">{media?.section_eyebrow ?? "DEMONSTRAÇÃO REAL"}</p>
            <h2 id="demos-heading">
              {media?.section_title ?? "Veja o produto funcionando"}
            </h2>

            <div class="demos">
              {demos.map((demo) => (
                <article class="demo-card">
                  <div class="demo-header">
                    <div>
                      <h3>{demo.title}</h3>
                      <p>{demo.caption}</p>
                    </div>
                    <button
                      type="button"
                      class="zoom-button"
                      data-zoom-src={demo.image}
                      data-zoom-alt={demo.alt}
                      data-zoom-title={demo.title}
                    >
                      Ampliar tela
                    </button>
                  </div>

                  <div class="demo-frame">
                    <img
                      src={demo.image}
                      alt={demo.alt}
                      width={demo.width}
                      height={demo.height}
                      loading="lazy"
                      decoding="async"
                      data-zoom-src={demo.image}
                      data-zoom-alt={demo.alt}
                      data-zoom-title={demo.title}
                    />
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        {content?.benefits?.length > 0 && (
          <section class="section" aria-labelledby="benefits-heading">
            <p class="eyebrow">O QUE VOCÊ ENCONTRA</p>
            <h2 id="benefits-heading">Benefícios</h2>

            <div class="benefits">
              {content.benefits.map((benefit, index) => (
                <div class="benefit">
                  <span class="number">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <p>{benefit}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        {content?.faqs?.length > 0 && (
          <section class="section" aria-labelledby="faq-heading">
            <p class="eyebrow">DÚVIDAS FREQUENTES</p>
            <h2 id="faq-heading">Perguntas e respostas</h2>

            <div class="faqs">
              {content.faqs.map((faq) => (
                <details>
                  <summary>{faq.question}</summary>
                  <p>{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        {preview && (
          <aside class="preview-notice">
            Esta página é uma prévia de desenvolvimento.
            O produto ainda não está disponível para compra aqui.
          </aside>
        )}
      </main>

      <footer>
        <span>© Prisma Dados</span>
        <span>Produtos digitais com inteligência.</span>
      </footer>
    </div>

    {demos.length > 0 && (
      <dialog id="demo-lightbox" class="lightbox" aria-labelledby="lightbox-title">
        <div class="lightbox-bar">
          <strong id="lightbox-title">Visualização</strong>
          <button type="button" id="lightbox-close" class="close-button">
            Fechar (ESC)
          </button>
        </div>
        <div class="lightbox-body">
          <img id="lightbox-img" src="" alt="" />
        </div>
      </dialog>
    )}
  </body>
</html>

<script>
  const page = document.body;
  const trackingUrl = page.dataset.trackingUrl;
  const productSlug = page.dataset.productSlug;
  const isPreview = page.dataset.preview === "true";

  if (trackingUrl && productSlug && !isPreview) {
    const sendTrackingEvent = (eventType) => {
      const payload = JSON.stringify({
        event_id: crypto.randomUUID(),
        event_type: eventType,
        product_slug: productSlug,
        occurred_at: new Date().toISOString(),
        consent_given: false,
      });
      navigator.sendBeacon?.(
        trackingUrl,
        new Blob([payload], { type: "application/json" })
      );
    };

    sendTrackingEvent("page_view");
    document.querySelector("[data-tracking-event='checkout_click']")
      ?.addEventListener("click", () => sendTrackingEvent("checkout_click"));
  }

  const dialog = document.getElementById("demo-lightbox") as HTMLDialogElement | null;
  const dialogImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
  const dialogTitle = document.getElementById("lightbox-title");
  const closeBtn = document.getElementById("lightbox-close");

  if (dialog && dialogImg && dialogTitle) {
    document.querySelectorAll("[data-zoom-src]").forEach((el) => {
      el.addEventListener("click", () => {
        const src = el.getAttribute("data-zoom-src") ?? "";
        const alt = el.getAttribute("data-zoom-alt") ?? "";
        const title = el.getAttribute("data-zoom-title") ?? "Demonstração";
        dialogImg.src = src;
        dialogImg.alt = alt;
        dialogTitle.textContent = title;
        dialog.showModal();
      });
    });

    closeBtn?.addEventListener("click", () => dialog.close());

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  }
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #090e1c;
    color: #f2f5ff;
    font-family: Inter, system-ui, sans-serif;
    overflow-x: hidden;
  }

  .container {
    width: min(1100px, calc(100% - 44px));
    margin: auto;
  }

  header, footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  header {
    padding: 32px 0;
    border-bottom: 1px solid #283247;
  }

  .brand {
    color: white;
    font-weight: 900;
    letter-spacing: 2px;
    text-decoration: none;
  }

  .brand span, .accent, .number {
    color: #91aaff;
  }

  .environment, .eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #9ab0ff;
  }

  .hero {
    padding: 64px 0 85px;
    max-width: 900px;
  }

  h1 {
    font-size: clamp(42px, 6.3vw, 76px);
    letter-spacing: -2px;
    line-height: 1.08;
    margin: 20px 0;
  }

  .subtitle {
    font-size: clamp(20px, 2.8vw, 29px);
    color: #c6d3ee;
    line-height: 1.45;
  }

  .description {
    max-width: 720px;
    color: #aab8d4;
    font-size: 17px;
    line-height: 1.85;
    margin-top: 28px;
    white-space: pre-line;
  }

  .actions {
    margin-top: 26px;
  }

  .buy-button, .unavailable {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    padding: 18px 25px;
    border-radius: 12px;
    font-weight: 750;
  }

  .buy-button {
    background: #98b0ff;
    color: #071126;
    text-decoration: none;
  }

  .buy-button:hover {
    background: #c4d0ff;
  }

  .buy-button:focus-visible,
  .zoom-button:focus-visible,
  .close-button:focus-visible {
    outline: 3px solid #d6e1ff;
    outline-offset: 3px;
  }

  .buy-button span {
    font-weight: 500;
  }

  .unavailable {
    background: #1c2942;
    color: #aebbd4;
  }

  .section {
    padding: 65px 0;
    border-top: 1px solid #283247;
  }

  h2 {
    font-size: clamp(28px, 4vw, 42px);
    letter-spacing: -1px;
    margin: 18px 0 36px;
  }

  .demos {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .demo-card {
    border: 1px solid #293753;
    background: #101a30;
    border-radius: 16px;
    padding: 24px;
    min-width: 0;
  }

  .demo-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  .demo-header h3 {
    margin: 0 0 8px;
    font-size: 20px;
    color: #f2f5ff;
  }

  .demo-header p {
    margin: 0;
    color: #b3bfd7;
    font-size: 15px;
    line-height: 1.6;
    max-width: 760px;
  }

  .zoom-button, .close-button {
    background: #1c2942;
    color: #d6e1ff;
    border: 1px solid #35476b;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 650;
    cursor: pointer;
    white-space: nowrap;
  }

  .zoom-button:hover, .close-button:hover {
    background: #27395c;
  }

  .demo-frame {
    width: 100%;
    overflow-x: auto;
    border-radius: 10px;
    border: 1px solid #22304b;
    background: #0a101f;
    -webkit-overflow-scrolling: touch;
  }

  .demo-frame img {
    display: block;
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }

  .lightbox {
    width: min(96vw, 1400px);
    max-height: 92vh;
    margin: auto;
    padding: 0;
    border: 1px solid #35476b;
    border-radius: 14px;
    background: #0d1528;
    color: #f2f5ff;
  }

  .lightbox::backdrop {
    background: rgba(4, 7, 15, 0.85);
    backdrop-filter: blur(4px);
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid #283247;
  }

  .lightbox-body {
    padding: 16px;
    overflow: auto;
    max-height: calc(92vh - 64px);
  }

  .lightbox-body img {
    display: block;
    max-width: none;
    height: auto;
    border-radius: 8px;
  }

  .benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .benefit, details {
    border: 1px solid #293753;
    background: #101a30;
    border-radius: 14px;
    padding: 24px;
  }

  .benefit p {
    font-size: 18px;
    line-height: 1.5;
    margin-bottom: 0;
  }

  details + details {
    margin-top: 12px;
  }

  summary {
    cursor: pointer;
    font-weight: 650;
    line-height: 1.5;
  }

  details p {
    color: #b3bfd7;
    line-height: 1.7;
  }

  .preview-notice {
    padding: 20px;
    border: 1px dashed #65759a;
    border-radius: 12px;
    color: #b4c3e0;
    margin: 25px 0 60px;
  }

  footer {
    padding: 30px 0 50px;
    border-top: 1px solid #283247;
    color: #9aa9c5;
    font-size: 13px;
  }

  @media (max-width: 700px) {
    header { flex-wrap: wrap; }
    .hero { padding: 52px 0 64px; }
    h1 {
      font-size: clamp(36px, 10vw, 48px);
      letter-spacing: -1.4px;
    }
    .buy-button, .unavailable {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
    .demo-card { padding: 18px; }
    .demo-header {
      flex-direction: column;
      align-items: stretch;
    }
    .zoom-button {
      width: 100%;
      text-align: center;
    }
    .demo-frame img {
      min-width: 680px;
    }
    .benefits { grid-template-columns: 1fr; }
    .section { padding: 45px 0; }
    footer { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(*),
    :global(*::before),
    :global(*::after) {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
